#include <stdio.h>

struct parcel
{
    int id;
    float weight;
    struct
    {
        char city[20];
        int pincode;
    } address;
    struct
    {
        int day, month, year;
    } date;
};

void sort_by_weight(struct parcel p[], int n)
{
    int i, j, min;
    struct parcel temp;

    for (i = 0; i < n - 1; i++)
    {
        min = i;

        for (j = i + 1; j < n; j++)
        {
            if (p[j].weight < p[min].weight)
                min = j;
        }

        if (min != i)
        {
            temp = p[i];
            p[i] = p[min];
            p[min] = temp;
        }
    }
}

void print_parcel(struct parcel p)
{
    printf("ID: %d | Weight: %.1f kg | City: %s | PIN: %d | Date: %02d-%02d-%d\n",
           p.id, p.weight, p.address.city, p.address.pincode,
           p.date.day, p.date.month, p.date.year);
}

int main(void)
{
    struct parcel list[3] = {
        {501, 4.5f, {"Madurai", 625001}, {12, 10, 2026}},
        {502, 1.2f, {"Chennai", 600077}, {12, 10, 2026}},
        {503, 2.8f, {"Coimbatore", 641001}, {13, 10, 2026}}
    };

    sort_by_weight(list, 3);

    printf("Parcels sorted by weight (lightest first):\n");

    for (int i = 0; i < 3; i++)
    {
        print_parcel(list[i]);
    }

    return 0;
}

