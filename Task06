#include <stdio.h>
#include <string.h>

#define MAX_ITEMS 100
#define MAX_SALES 200
#define MAX_COMBO_ITEMS 3

typedef struct
{
    int day, month, year;
} Date;

typedef struct
{
    int hour, minute;
} Time;

typedef struct
{
    Date expiry;
} Packaged;

typedef struct
{
    Time prepared;
} Cooked;

typedef struct
{
    int item_id[MAX_COMBO_ITEMS];
    int quantity[MAX_COMBO_ITEMS];
    int count;
} Combo;

typedef union
{
    Packaged packaged;
    Cooked cooked;
    Combo combo;
} ItemDetails;

typedef enum
{
    PACKAGED = 1,
    COOKED,
    COMBO
} ItemType;

typedef struct
{
    int id;
    char name[40];
    ItemType type;
    float price;
    int stock;
    ItemDetails details;
} Item;

typedef struct
{
    int item_id;
    int quantity;
    float revenue;
} Sale;

/* Shared inventory and sales records */
Item items[MAX_ITEMS];
Sale sales[MAX_SALES];

int itemCount = 0;
int saleCount = 0;

/* Find an item using its ID */
int findItem(const Item *items, int count, int id)
{
    for (int i = 0; i < count; i++)
    {
        if (items[i].id == id)
            return i;
    }
    return -1;
}

/* Convert a date into a serial day number */
long dateToDays(Date d)
{
    long total = 0;

    for (int y = 1; y < d.year; y++)
    {
        total += 365;

        if ((y % 400 == 0) ||
            (y % 4 == 0 && y % 100 != 0))
            total++;
    }

    int monthDays[] = {
        31, 28, 31, 30, 31, 30,
        31, 31, 30, 31, 30, 31
    };

    for (int m = 1; m < d.month; m++)
    {
        total += monthDays[m - 1];

        if (m == 2 &&
            ((d.year % 400 == 0) ||
             (d.year % 4 == 0 && d.year % 100 != 0)))
            total++;
    }

    return total + d.day;
}

/* Record a sale and update stock safely */
int recordSale(Item *items, int count,
               Sale *sales, int *saleCount,
               int itemId, int quantity)
{
    int index = findItem(items, count, itemId);

    if (index == -1 || quantity <= 0)
    {
        printf("Invalid item or quantity.\n");
        return 0;
    }

    Item *item = &items[index];

    /* Check all combo components before changing stock */
    if (item->type == COMBO)
    {
        Combo *c = &item->details.combo;

        for (int i = 0; i < c->count; i++)
        {
            int componentIndex =
                findItem(items, count, c->item_id[i]);

            if (componentIndex == -1 ||
                items[componentIndex].stock <
                c->quantity[i] * quantity)
            {
                printf("Insufficient stock for combo %s.\n",
                       item->name);
                return 0;
            }
        }

        /* Deduct component stock only after all checks pass */
        for (int i = 0; i < c->count; i++)
        {
            int componentIndex =
                findItem(items, count, c->item_id[i]);

            items[componentIndex].stock -=
                c->quantity[i] * quantity;
        }
    }
    else
    {
        if (item->stock < quantity)
        {
            printf("Insufficient stock for %s.\n",
                   item->name);
            return 0;
        }

        item->stock -= quantity;
    }

    float amount = item->price * quantity;

    /* Combine repeated sales of the same item */
    int found = 0;

    for (int i = 0; i < *saleCount; i++)
    {
        if (sales[i].item_id == itemId)
        {
            sales[i].quantity += quantity;
            sales[i].revenue += amount;
            found = 1;
            break;
        }
    }

    if (!found && *saleCount < MAX_SALES)
    {
        sales[*saleCount].item_id = itemId;
        sales[*saleCount].quantity = quantity;
        sales[*saleCount].revenue = amount;
        (*saleCount)++;
    }

    printf("Sale successful: %s | Quantity: %d | Amount: Rs. %.2f\n",
           item->name, quantity, amount);

    return 1;
}

/* Warn about packaged items expiring within two days */
void checkExpiry(const Item *items, int count, Date today)
{
    long todayNumber = dateToDays(today);

    printf("\nEXPIRY WARNINGS\n");

    for (int i = 0; i < count; i++)
    {
        if (items[i].type == PACKAGED)
        {
            Date expiry = items[i].details.packaged.expiry;
            long remaining = dateToDays(expiry) - todayNumber;

            if (remaining >= 0 && remaining <= 2)
            {
                printf("%s expires in %ld day(s).\n",
                       items[i].name, remaining);
            }
        }
    }
}

/* Sort sales by revenue in descending order */
void sortSummary(Sale *sales, int count)
{
    for (int i = 0; i < count - 1; i++)
    {
        for (int j = i + 1; j < count; j++)
        {
            if (sales[j].revenue > sales[i].revenue)
            {
                Sale temp = sales[i];
                sales[i] = sales[j];
                sales[j] = temp;
            }
        }
    }
}

/* Print the daily revenue summary */
void printSummary(const Sale *sales, int saleCount,
                  const Item *items, int itemCount)
{
    float total = 0;

    printf("\nDAILY BILL SUMMARY\n");
    printf("------------------------------------------\n");
    printf("%-15s %-10s %-12s\n",
           "Item", "Quantity", "Revenue");

    for (int i = 0; i < saleCount; i++)
    {
        int index = findItem(items, itemCount,
                             sales[i].item_id);

        if (index != -1)
        {
            printf("%-15s %-10d Rs. %-9.2f\n",
                   items[index].name,
                   sales[i].quantity,
                   sales[i].revenue);

            total += sales[i].revenue;
        }
    }

    printf("------------------------------------------\n");
    printf("Total Revenue: Rs. %.2f\n", total);
}

int main(void)
{
    Date today = {20, 11, 2026};

    /* Packaged item */
    items[0].id = 1;
    strcpy(items[0].name, "Juice");
    items[0].type = PACKAGED;
    items[0].price = 30;
    items[0].stock = 10;
    items[0].details.packaged.expiry =
        (Date){21, 11, 2026};

    /* Cooked item */
    items[1].id = 2;
    strcpy(items[1].name, "Idli");
    items[1].type = COOKED;
    items[1].price = 20;
    items[1].stock = 20;
    items[1].details.cooked.prepared =
        (Time){8, 30};

    /* Combo meal containing one juice and two idlis */
    items[2].id = 3;
    strcpy(items[2].name, "ComboMeal");
    items[2].type = COMBO;
    items[2].price = 50;
    items[2].stock = 0;
    items[2].details.combo.count = 2;
    items[2].details.combo.item_id[0] = 1;
    items[2].details.combo.quantity[0] = 1;
    items[2].details.combo.item_id[1] = 2;
    items[2].details.combo.quantity[1] = 2;

    itemCount = 3;

    printf("COLLEGE CANTEEN INVENTORY AND BILLING\n");
    printf("Today's date: 20-11-2026\n\n");

    /* Normal sales */
    recordSale(items, itemCount, sales, &saleCount, 1, 2);
    recordSale(items, itemCount, sales, &saleCount, 2, 3);

    /* Sale exceeding available stock */
    recordSale(items, itemCount, sales, &saleCount, 1, 20);

    /* Combo sale */
    recordSale(items, itemCount, sales, &saleCount, 3, 2);

    /* Expiry warning */
    checkExpiry(items, itemCount, today);

    /* Sort and print summary */
    sortSummary(sales, saleCount);
    printSummary(sales, saleCount, items, itemCount);

    return 0;
}

