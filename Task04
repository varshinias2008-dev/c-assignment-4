#include <stdio.h>

struct account
{
    int number;
    float balance;
};

void addInterest(struct account *a, float rate)
{
    a->balance = a->balance + a->balance * rate / 100;
}

int main(void)
{
    struct account list[3] = {
        {101, 5000},
        {102, 12000},
        {103, 800}
    };

    struct account *p = list;

    for (int i = 0; i < 3; i++)
    {
        addInterest(&list[i], 4);
    }

    printf("Account Number\tBalance\n");

    for (int i = 0; i < 3; i++)
    {
        printf("%d\t\t%.2f\n",
               (p + i)->number,
               (p + i)->balance);
    }

    return 0;
}

OUTPUT:

